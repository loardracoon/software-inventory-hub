# Edge Function env for local runs: copy to supabase/functions/.env (git-ignored).
# Admin email for new reclassification requests (Resend). Leave empty to skip email (the inbox still gets it).
RESEND_API_KEY=
HUB_EMAIL_FROM=
# Link in the emails.
HUB_CONSOLE_URL=http://localhost:5175
# Test only: point Resend at a local mock (../client: npm run mock:alerts → http://host.docker.internal:54997/emails).
RESEND_API_URL=
# Shared secret pg_cron sends in x-cron-secret (also stored in Vault by `npm run cron:configure`).
CRON_SECRET=
# Jev: the Claude API key turns the real classifier on; without it the local mock answers.
ANTHROPIC_API_KEY=
# Optional: force a provider (claude | mock). Test only: make every Nth mock call fail.
JEV_PROVIDER=
RESEARCH_PROVIDER=
JEV_MOCK_FAIL_EVERY=
